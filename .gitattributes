# Keep the release archive loadable for consumers: tests/ and tools/ load
# dev-only modules (rules_itest, rules_kind, rules_shell, rules_helm), which a
# consumer can't see, so `bazel query @rules_cilium//...` would fail on them.
# GitHub's tag tarballs honour export-ignore. (A git_override clone still has
# them.)
tests/ export-ignore
tools/ export-ignore
